# Contoh dokumentasi env untuk Rames.
# JANGAN menaruh nilai rahasia di file ini. Nilai asli diisi di tab Environment Rames.

# URL publik app (harus sama dengan domain/subdomain di Rames)
APP_URL=https://app.example.com

# Timezone container
TZ=Asia/Jakarta

# Database (nilai asli diisi di Rames, bukan di repo)
DB_NAME=app
DB_USER=app
DB_PASSWORD=
